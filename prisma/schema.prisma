// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Settings {
  id              String   @id @default(cuid())
  experienceId    String // Whop experience/community ID
  userId          String // External user ID from Whop
  agentName       String   @default("Support Agent")
  welcomeMessage  String   @default("Thank you for contacting support. How can we help you today?")
  autoMessage     String   @default("We've received your ticket and will respond shortly.")
  reminderMessage String   @default("Hi! Just checking in on your support ticket. Do you need any additional help?")
  reminderEnabled Boolean  @default(true)
  reminderHours   Int      @default(12)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([experienceId, userId])
  @@map("settings")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  experienceId String // Whop experience/community ID

  // Relations
  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id           String       @id @default(cuid())
  experienceId String // Whop experience/community ID
  title        String
  description  String
  status       TicketStatus @default(OPEN)
  priority     Priority     @default(MEDIUM)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  claimedAt    DateTime?
  closedAt     DateTime?

  // Relations - using external user IDs from Whop
  creatorId  String // External user ID from Whop
  agentId    String? // External user ID from Whop (admin users)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  messages   Message[]
  review     Review?

  @@map("tickets")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId String // External user ID from Whop

  @@map("messages")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 stars
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  experienceId String // Whop experience/community ID

  // Relations
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String // External user ID from Whop

  @@map("reviews")
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
